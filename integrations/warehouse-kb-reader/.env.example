# GoClaw API Key (Scope operator.read, tenant-bound to 0193a5b0-7000-7000-8000-000000000001)
GOCLAW_API_KEY=your_goclaw_operator_read_api_key_here

# Bearer token protecting adapter MCP endpoint from unauthorized callers
# Entropy >= 32 hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADAPTER_BEARER_TOKEN=generate_random_secret_bearer_token_for_adapter

# Secret key for HMAC signature on opaque pagination cursors
CURSOR_SECRET=generate_random_secret_cursor_hmac_key
